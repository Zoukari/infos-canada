generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Source {
  id              String    @id @default(cuid())
  name            String
  url             String
  rssUrl          String?
  type            String    @default("rss")
  province        String?
  defaultCategory String?
  active          Boolean   @default(true)
  lastSyncAt      DateTime?
  articlesCount   Int       @default(0)
  errorCount      Int       @default(0)
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  articles        Article[]
  scrapingLogs    ScrapingLog[]
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  nameEn   String?
  province String?
  color    String?
  icon     String?
  priority Int       @default(0)
  active   Boolean   @default(true)
  articles Article[]
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  originalTitle   String
  originalUrl     String    @unique
  contentHash     String?
  sourceId        String
  publishedAt     DateTime
  scrapedAt       DateTime  @default(now())
  summary         String?
  whyItMatters    String?
  keyFacts        Json?
  categoryId      String?
  province        String?
  city            String?
  importanceScore Int       @default(50)
  status          String    @default("published")
  imageUrl        String?
  keywords        String[]  @default([])
  politicalTags   String[]  @default([])
  policyStatus    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  source          Source    @relation(fields: [sourceId], references: [id])
  category        Category? @relation(fields: [categoryId], references: [id])
}

model WatchItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    @default("date")
  province    String?
  dueDate     DateTime?
  sourceUrl   String?
  active      Boolean   @default(true)
  priority    Int       @default(50)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ScrapingLog {
  id              String    @id @default(cuid())
  sourceId        String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String    @default("running")
  articlesFetched Int       @default(0)
  articlesNew     Int       @default(0)
  errorMessage    String?
  source          Source?   @relation(fields: [sourceId], references: [id])
}

model DailyDigest {
  id          String   @id @default(cuid())
  date        DateTime @unique
  topArticles Json     @default("[]")
  nbArticles  Int      @default(0)
  caArticles  Int      @default(0)
  totalCount  Int      @default(0)
  createdAt   DateTime @default(now())
}
